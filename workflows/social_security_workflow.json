{
  "id": "social_security_workflow",
  "name": "社保清单查询和打印",
  "description": "导航到广东政务服务网并查询社保清单",
  "version": "1.1",
  "actions": [
    {
      "id": "navigate_and_select_person",
      "name": "导航并查询社保清单",
      "description": "使用高级封装功能导航到社保清单查询页面并完成操作",
      "steps": [
        {
          "id": "step_1",
          "action": "get_or_create_tab",
          "parameters": {
            "url": "https://www.gdzwfw.gov.cn/portal/index?region=440300"
          },
          "description": "获取或创建广东政务服务网标签页"
        },
        {
          "id": "step_2",
          "action": "request_user_action",
          "parameters": {
            "type": "login",
            "message": "请用户登录",
            "description": "当前页面需要用户登录个人账户",
            "options": []
          },
          "description": "请求用户登录个人账户"
        },
        {
          "id": "step_3",
          "action": "search_and_navigate",
          "parameters": {
            "base_url": "https://www.gdzwfw.gov.cn/portal/index?region=440300",
            "search_keyword": "社保清单打印",
            "search_button_text": "搜索",
            "result_keyword": "社保查询",
            "wait_after_search": 2
          },
          "description": "搜索社保清单并导航到相关页面"
        },
        {
          "id": "step_4",
          "action": "find_and_click",
          "parameters": {
            "text": "个人权益记录（参保证明）查询打印(个人参保证明查询打印)",
            "partial_match": true
          },
          "description": "点击个人权益记录查询打印链接"
        },
        {
          "id": "step_5",
          "action": "find_and_click",
          "parameters": {
            "text": "在线办理"
          },
          "description": "点击在线办理按钮"
        },
        {
          "id": "step_6",
          "action": "highlight_elements",
          "parameters": {
            "viewport_expansion": 500
          },
          "description": "高亮页面元素方便用户查看"
        },
        {
          "id": "step_7",
          "action": "find_and_click",
          "parameters": {
            "text": "选择"
          },
          "description": "点击选择按钮"
        },
        {
          "id": "step_8",
          "action": "find_and_click",
          "parameters": {
            "text": "下载"
          },
          "description": "点击下载按钮"
        },
        {
          "id": "step_9",
          "action": "done",
          "parameters": {
            "success": true,
            "text": "社保清单查询完成并已下载"
          },
          "description": "完成查询"
        }
      ]
    }
  ]
}