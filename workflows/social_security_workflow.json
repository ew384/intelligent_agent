{
  "id": "social_security_workflow",
  "name": "社保清单查询和打印",
  "description": "导航到广东政务服务网并查询社保清单",
  "keywords": [
    "社保"
  ],
  "version": "1.1",
  "action": [
    {
      "id": "navigate_and_select_person",
      "name": "导航并查询社保清单",
      "description": "使用高级封装功能导航到社保清单查询页面并完成操作",
      "steps": [
        {
          "id": "step_1",
          "action": "get_or_create_tab",
          "parameters": {
            "url": "https://www.gdzwfw.gov.cn/portal/index?region=440300"
          },
          "description": "获取或创建广东政务服务网标签页"
        },
        {
          "id": "step_2",
          "action": "check_condition_and_execute",
          "parameters": {
            "condition_check": {
              "type": "is_logged_in",
              "parameters": {
                "login_button_text": "登录",
                "user_element_text": "我的"
              }
            },
            "action_if_true": {
              "wait": {
                "time": 0.5,
                "message": "用户已登录，跳过登录步骤"
              }
            },
            "action_if_false": {
              "request_user_action": {
                "type": "login",
                "message": "请登录您的小红书账号",
                "description": "需要您手动完成小红书账号的登录，以便继续执行搜索'中信银行信用卡'的操作。"
              }
            }
          },
          "description": "检查登录状态 - 如果已登录则继续，否则请求用户手动登录"
        },
        {
          "id": "step_3",
          "action": "search_and_navigate",
          "parameters": {
            "base_url": "https://www.gdzwfw.gov.cn/portal/index?region=440300",
            "search_keyword": "社保清单打印",
            "search_button_text": "搜索",
            "result_keyword": "社保查询",
            "wait_after_search": 2
          },
          "description": "搜索社保清单并导航到相关页面"
        },
        {
          "id": "step_4",
          "action": "find_and_click",
          "parameters": {
            "text": "个人权益记录（参保证明）查询打印(个人参保证明查询打印)",
            "partial_match": true
          },
          "description": "点击个人权益记录查询打印链接"
        },
        {
          "id": "step_5",
          "action": "find_and_click",
          "parameters": {
            "text": "在线办理"
          },
          "description": "点击在线办理按钮"
        },
        {
          "id": "step_6",
          "action": "find_and_click",
          "parameters": {
            "text": "选择"
          },
          "description": "点击选择按钮"
        },
        {
          "id": "step_7",
          "action": "find_and_click",
          "parameters": {
            "text": "下载"
          },
          "description": "点击下载按钮"
        },
        {
          "id": "step_8",
          "action": "done",
          "parameters": {
            "success": true,
            "text": "社保清单查询完成并已下载"
          },
          "description": "完成查询"
        }
      ]
    }
  ]
}